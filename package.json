{
  "name": "typingbull",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "multiplayer": "node --experimental-strip-types server/standaloneMultiplayer.ts",
    "classroom": "node --experimental-strip-types server/standaloneClassroom.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:worker": "cd workers/multiplayer && wrangler deploy",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=typingbull"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.33.0",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.129.0"
  }
}
