---
/**
 * Global BaseLayout.astro
 * Encapsulates <HeadSEO>, dynamic lang attribute on <html>,
 * glassmorphic header with <LanguageSwitcher />, and slot content.
 */
import HeadSEO from '../components/HeadSEO.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getLangFromUrl } from '../i18n/utils';
import { LANGUAGES, DEFAULT_LOCALE } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={currentLang} dir="ltr">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PEB27YTSN1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PEB27YTSN1');
    </script>
    <HeadSEO title={title} description={description} />
  </head>
  <body class="min-h-screen bg-slate-50 dark:bg-[#0b101b] text-slate-900 dark:text-slate-100 antialiased font-sans transition-colors duration-200">
    <!-- Global Header with Language Switcher -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-lg bg-white/70 dark:bg-slate-900/70 border-b border-slate-200/60 dark:border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={currentLang === DEFAULT_LOCALE ? '/' : `/${currentLang}`} class="flex items-center gap-2.5 font-extrabold text-xl tracking-tight text-blue-600 dark:text-blue-400">
          <span class="text-2xl">🐂</span>
          <span>TypingBull</span>
        </a>

        <div class="flex items-center gap-4">
          <!-- Glassmorphic Global Language Switcher -->
          <LanguageSwitcher variant="compact" />
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>
  </body>
</html>
